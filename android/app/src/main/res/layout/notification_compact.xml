<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:background="@color/widget_bg_black">

        <!-- CO2 Value -->
        <LinearLayout
            android:id="@+id/co2_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/co2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="----"
                android:textColor="?android:textColorPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="CO₂ ppm"
                android:textColor="?android:textColorSecondary"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- Right section: Battery and Quick Actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/refresh_layout"
            android:layout_toEndOf="@id/co2_layout"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:orientation="vertical">

                <!-- Battery -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/battery_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_battery"
                        android:tint="?android:textColorPrimary" />

                    <TextView
                        android:id="@+id/battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:alpha="0.9"
                        android:text="0%"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="10sp"
                        android:textStyle="bold" />


                </LinearLayout>

                <!-- Battery -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/power_mode_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_power_mode"
                        android:tint="?android:textColorPrimary" />

                    <TextView
                        android:id="@+id/power_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:alpha="0.9"
                        android:text="0%"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="10sp"
                        android:textStyle="bold" />


                </LinearLayout>

            </LinearLayout>


        </LinearLayout>

        <!-- Refresh Icon/Animation Container -->
        <FrameLayout
            android:id="@+id/refresh_layout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">

            <!-- Static Refresh Icon -->
            <ImageView
                android:id="@+id/ic_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="Refresh"
                android:src="@drawable/refresh_button_dark"
                android:visibility="visible" />

            <!-- Animated Progress Ring (shown when refreshing) -->
            <ProgressBar
                android:id="@+id/progress_refresh"
                style="?android:attr/progressBarStyle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="?android:colorPrimary"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Battery -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/layout_graph"
            android:layout_toEndOf="@id/refresh_layout"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/vibrate_mode"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/alarm_off"
                android:layout_marginBottom="4dp"
                android:tint="?android:textColorPrimary" />

            <ImageView
                android:id="@+id/alarm_mode"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/vibrate_off"
                android:tint="?android:textColorPrimary" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/layout_graph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <!-- Map Icon -->
            <ImageView
                android:id="@+id/ic_map"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Map"
                android:src="@drawable/ic_map" />

            <!-- Graph Icon -->
            <ImageView
                android:id="@+id/ic_graph"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Graph"
                android:src="@drawable/ic_graph" />
        </LinearLayout>


    </RelativeLayout>

    <!-- CO2 History Graph -->
    <ImageView
        android:id="@+id/co2_graph"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginVertical="6dp"
        android:background="@drawable/graph_background"
        android:scaleType="fitXY" />

</LinearLayout>


<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="AIR"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="SPOT"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_background_light"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <!-- Sound Mode Icon -->
            <ImageView
                android:id="@+id/sound_mode"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="4dp"
                android:background="@drawable/sound_mode_icon_off" />

            <!-- Vibration Mode Icon -->
            <ImageView
                android:id="@+id/vibration_mode"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="4dp"
                android:background="@drawable/vibration_mode_icon_off" />

            <!-- Battery Percentage -->
            <TextView
                android:id="@+id/battery_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:gravity="end"
                android:layout_weight="1"
                android:text="100%"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />


        </LinearLayout>

        <!-- Main CO2 Value -->
        <TextView
            android:id="@+id/co2_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-condensed"
            android:text="0426"
            android:textAlignment="center"
            android:textColor="#4CAF50"
            android:textSize="40sp"
            android:textStyle="bold" />

        <!-- Time and Unit Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Time Display -->
            <TextView
                android:id="@+id/time_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:alpha="0.8"
                android:text="3 min"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- CO2 Unit -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:text="CO₂ppm"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Refresh Button -->
    <ImageButton
        android:id="@+id/refresh_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/refresh_button_dark"
        android:contentDescription="Refresh CO₂ Value"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:tint="#FFFFFF" />


</LinearLayout>

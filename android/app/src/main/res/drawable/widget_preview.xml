<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape>
            <solid android:color="#FF000000" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#333333"
                android:alpha="0.3"/>
        </shape>
    </item>

    <!-- Content Preview -->
    <item android:gravity="center">
        <layer-list>

            <!-- Large CO2 Value -->
            <item android:gravity="center"
                android:top="-12dp">
                <shape>
                    <size
                        android:width="50dp"
                        android:height="10dp" />
                    <solid android:color="#4CAF50" />
                    <corners android:radius="2dp" />
                </shape>
            </item>

            <!-- Time and Unit indicators -->
            <item
                android:gravity="center"
                android:top="8dp">
                <layer-list>
                    <item android:gravity="left">
                        <shape>
                            <size
                                android:width="14dp"
                                android:height="2dp" />
                            <solid android:color="#FFFFFF" />
                            <corners android:radius="1dp" />
                        </shape>
                    </item>
                    <item android:gravity="right">
                        <shape>
                            <size
                                android:width="18dp"
                                android:height="2dp" />
                            <solid android:color="#FFFFFF" />
                            <corners android:radius="1dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>

            <!-- Device name at bottom left -->
            <item
                android:gravity="left|bottom"
                android:bottom="8dp"
                android:left="8dp">
                <shape>
                    <size
                        android:width="20dp"
                        android:height="2dp" />
                    <solid android:color="#CCCCCC" />
                    <corners android:radius="1dp" />
                </shape>
            </item>

            <!-- Refresh Button -->
            <item
                android:gravity="right|bottom"
                android:right="8dp"
                android:bottom="8dp">
                <shape android:shape="oval">
                    <size
                        android:width="10dp"
                        android:height="10dp" />
                    <solid android:color="#333333" />
                    <stroke
                        android:width="1dp"
                        android:color="#555555" />
                </shape>
            </item>
        </layer-list>
    </item>
</layer-list>
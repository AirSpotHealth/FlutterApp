<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AirSpot Widget Theme -->
    <style name="Theme.AirSpotWidget.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <!-- Radius for the outer bound of widgets to make the rounded corners -->
        <item name="appWidgetRadius">16dp</item>
        <!--
        Radius for the inner view's bound of widgets to make the rounded corners.
        It needs to be 8dp or less than the value of appWidgetRadius
        -->
        <item name="appWidgetInnerRadius">8dp</item>
    </style>

    <style name="Theme.AirSpotWidget.AppWidgetContainer" parent="Theme.AirSpotWidget.AppWidgetContainerParent">
        <!-- Apply padding to avoid the content of the widget colliding with the rounded corners -->
        <item name="appWidgetPadding">16dp</item>
    </style>
</resources>